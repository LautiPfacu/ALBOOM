# Copiá este archivo como .env y completá los valores. El .env NO se sube a GitHub.

# Firebase: públicas (van al navegador). Salen de firebaseConfig.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Spotify: secretas. Sin prefijo VITE_ para que nunca lleguen al navegador.
# Solo las lee la función api/spotify.js.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
